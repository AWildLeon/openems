# direnv .envrc to enter the flake devShell for this repository
# Uses the devShell attribute defined in flake.nix

# Explicitly use the flake devShell for x86_64-linux
use flake .#devShells.x86_64-linux.default

# Prefer zsh as the login shell where available
if [ -x "$(command -v zsh)" ]; then
  export SHELL="$(command -v zsh)"
fi

# Ensure the devshell and the shellHook use a deterministic dotdir
export ZDOTDIR="$PWD/.devshell-zsh"
